# Firebase — DO NOT set VITE_AUTH_API_URL here.
# Leaving it unset makes apiClient and auth-client fall back to
# window.location.origin, so all /api/* requests go through the
# Vercel rewrite proxy (vercel.json) to https://fankit-server.onrender.com
# This keeps cookies first-party and avoids CORS issues.

VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_LIVE_KEY

# Firebase Web config — paste from Firebase Console -> Project settings -> General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
