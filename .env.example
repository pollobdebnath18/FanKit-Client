# FanKit Client — Environment Variables
# Copy this file to .env (dev) or .env.production (prod) and fill in values.

# API base URL — DEV ONLY. In production leave this unset so the Vercel
# rewrite proxy (vercel.json) routes /api/* to the hosted server.
VITE_AUTH_API_URL=http://localhost:8000

# Stripe publishable key (Stripe Dashboard -> Developers -> API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx

# Firebase Web configuration (Firebase Console -> Project settings -> General)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=